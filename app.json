{
  "expo": {
    "name": "NGFreshFoods",
    "slug": "NGFreshFoods",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/user_splash_v9.png",
        "resizeMode": "cover",
        "backgroundColor": "#d9dcb9"
      }
    },
    "android": {
      "package": "com.nick.ngfreshfoods",
      "versionCode": 1,
      "permissions": [],
      "splash": {
        "image": "./assets/images/user_splash_v9.png",
        "resizeMode": "cover",
        "backgroundColor": "#d9dcb9"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/transparent_1x1.png",
        "backgroundColor": "#d9dcb9"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "https://res.cloudinary.com/djv3mrzk2/image/upload/c_crop,ar_9:16/v1737137430/SS7_pkphek.jpg"
    },
    "splash": {
      "image": "./assets/images/user_splash_v9.png",
      "resizeMode": "cover",
      "backgroundColor": "#d9dcb9"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/user_splash_v9.png",
          "resizeMode": "cover",
          "backgroundColor": "#d9dcb9"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9bcd6544-2221-42d1-bf0a-58cb225a525c"
      }
    }
  }
}
