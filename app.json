{
  "expo": {
    "name": "NGFreshFoods",
    "slug": "NGFreshFoods",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "https://res.cloudinary.com/djv3mrzk2/image/upload/v1737377776/logo_ppjvcb.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "https://res.cloudinary.com/djv3mrzk2/image/upload/v1737377776/logo_ppjvcb.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "https://res.cloudinary.com/djv3mrzk2/image/upload/c_crop,ar_9:16/v1737137430/SS7_pkphek.jpg"
    },
    "splash": {
      "image": "https://res.cloudinary.com/djv3mrzk2/image/upload/v1737377776/logo_ppjvcb.png",
      "resizeMode": "contain",
      "backgroundColor": "#e6d819"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "https://res.cloudinary.com/djv3mrzk2/image/upload/v1737377776/logo_ppjvcb.png",
          "resizeMode": "cover",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
