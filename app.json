{
  "expo": {
    "name": "NGFreshFoods",
    "slug": "NGFreshFoods",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "ngfreshfoods",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      },
      "splash": {
        "image": "./assets/images/ngfreshfoods_final_splash_v10.png",
        "resizeMode": "cover",
        "backgroundColor": "#151515"
      },
      "bundleIdentifier": "com.nick.ngfreshfoods",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.nick.ngfreshfoods",
      "googleServicesFile": "./google-services.json",
      "backgroundColor": "#151515",
      "versionCode": 18,
      "permissions": ["POST_NOTIFICATIONS"],
      "splash": {
        "image": "./assets/images/ngfreshfoods_final_splash_v10.png",
        "resizeMode": "cover",
        "backgroundColor": "#151515"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#151515"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "https://res.cloudinary.com/djv3mrzk2/image/upload/c_crop,ar_9:16/v1737137430/SS7_pkphek.jpg"
    },
    "splash": {
      "image": "./assets/images/ngfreshfoods_final_splash_v10.png",
      "resizeMode": "cover",
      "backgroundColor": "#151515"
    },
    "plugins": [
      [
        "@sentry/react-native",
        {
          "organization": "freshfarmworks",
          "project": "freshfarmfoods"
        }
      ],
      "expo-router",
      "@react-native-firebase/app",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ngfreshfoods_final_splash_v10.png",
          "resizeMode": "cover",
          "backgroundColor": "#151515"
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/withFullScreenSplash"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9bcd6544-2221-42d1-bf0a-58cb225a525c"
      },
      "firebase": {
        "apiKey": "EXPO_PUBLIC_FIREBASE_API_KEY",
        "authDomain": "EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN",
        "projectId": "EXPO_PUBLIC_FIREBASE_PROJECT_ID",
        "storageBucket": "EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET",
        "messagingSenderId": "EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID",
        "appId": "EXPO_PUBLIC_FIREBASE_APP_ID"
      }
    }
  }
}
